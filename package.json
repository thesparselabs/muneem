{
  "name": "muneem",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first billing, inventory and accounting for Indian retail — monorepo",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "gen": "turbo run gen",
    "schema-lint": "tsx scripts/schema-lint.ts",
    "diff-fuzz": "tsx scripts/diff-fuzz.ts",
    "e2e:cloud": "bash scripts/e2e-cloud.sh",
    "gen:preload": "tsx scripts/gen-preload.ts",
    "release:version": "tsx scripts/release-version.ts",
    "release:manifest": "tsx scripts/release-manifest.ts",
    "release:promote": "tsx scripts/release-promote.ts",
    "e2e:ui": "pnpm --filter @muneem/desktop e2e:ui",
    "chaos": "pnpm --filter @muneem/desktop chaos"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
