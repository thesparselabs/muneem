# deploy/monitoring/.env on the monitoring VM (and, for the agent, on the API VM): copy, fill in, `chmod 600 .env`.

# --- Hosts ---
GRAFANA_DOMAIN=grafana.muneem.app
# Desktops send crash reports here (ADR-0053); its DNS must point at this VM.
CRASH_DOMAIN=crash.muneem.app
ACME_EMAIL=ops@example.com

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Where alerts go (the "ops" contact point). Set the SMTP values for e-mail to work.
MUNEEM_ALERT_EMAIL=ops@example.com
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=alerts@example.com

# --- Storage ---
PROMETHEUS_RETENTION=30d
# The private (WireGuard) address agents push logs to; 127.0.0.1 when everything runs on one VM.
LOKI_BIND=10.80.0.2

# --- Crash collector: the API image, run as `crash-collector` ---
MUNEEM_IMAGE=ghcr.io/thesparselabs/muneem-api
MUNEEM_TAG=CHANGE_ME
# The DSN's public key the desktop is built with (MUNEEM_CRASH_DSN = https://<key>@<CRASH_DOMAIN>/1); 16+ characters.
MUNEEM_CRASH_KEY=CHANGE_ME_AT_LEAST_16

# --- Log agent (docker-compose.agent.yml) ---
LOKI_URL=http://10.80.0.2:3100/loki/api/v1/push
MUNEEM_HOST=monitoring-1
