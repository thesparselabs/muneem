# deploy/.env on the VM: copy this file, fill it in, `chmod 600 .env`. Never commit the filled-in copy.
# Generate secrets with: openssl rand -base64 32   (master keys must be exactly that: base64 of 32 bytes)

# --- Image and host ---
# Registry repository of the API image (cloud/Dockerfile); deploy.sh supplies the tag.
MUNEEM_IMAGE=ghcr.io/thesparselabs/muneem-api
# Public hostname of the API; its DNS A/AAAA record must point at this VM before Caddy can get a certificate.
MUNEEM_API_DOMAIN=api.muneem.app
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com

# --- Database (managed Postgres with point-in-time recovery) ---
# The API connects as muneem_app (RLS applies). Use sslmode=verify-full with the provider's CA where offered.
DATABASE_URL=postgres://muneem_app:CHANGE_ME@db.example.internal:5432/muneem?sslmode=require
# Password deploy.sh sets on muneem_app through roles.sql; must match DATABASE_URL. At least 24 characters.
MUNEEM_APP_DB_PASSWORD=CHANGE_ME
# The owner role: runs migrate-up, roles.sql and rewrap. Read by deploy.sh only, never passed to the API container.
MUNEEM_OWNER_DATABASE_URL=postgres://muneem_owner:CHANGE_ME@db.example.internal:5432/muneem?sslmode=require

# --- Access tokens (ADR-0052) ---
# Keyring "kid:secret,kid:secret"; the first signs, all verify. Each secret at least 32 bytes.
JWT_SECRETS=k1:CHANGE_ME_AT_LEAST_32_BYTES_LONG_SECRET
# Legacy single secret: verifies tokens without a kid during a move to JWT_SECRETS. Leave empty otherwise.
JWT_SECRET=

# --- Object storage (managed, S3-compatible) ---
# A URL; https:// for managed storage. The bucket is created if missing; apply s3-lifecycle.json to it.
MUNEEM_S3_ENDPOINT=https://s3.example.com
MUNEEM_S3_BUCKET=muneem-prod
MUNEEM_S3_ACCESS_KEY=CHANGE_ME
MUNEEM_S3_SECRET_KEY=CHANGE_ME
MUNEEM_S3_REGION=ap-south-1

# --- Backup key escrow (ADR-0047, ADR-0052) ---
# Keyring "version:base64,version:base64"; the first wraps new keys, all unwrap. Keep a copy offline: losing every
# version that wrapped a key makes that business's cloud backups unrecoverable.
MUNEEM_BACKUP_MASTER_KEYS=v1:CHANGE_ME_BASE64_OF_32_BYTES
# Legacy single master key; joins the ring as v1. Leave empty when v1 is in MUNEEM_BACKUP_MASTER_KEYS.
MUNEEM_BACKUP_MASTER_KEY=

# --- Behaviour ---
# info | debug
LOG_LEVEL=info
# Oldest sync protocol accepted; empty means current − 1 (ADR-0049).
MUNEEM_SYNC_MIN_PROTOCOL=

# --- Monitoring (ADR-0053, docs/operations/deploy.md §8) ---
# Address the metrics port is published on: this VM's WireGuard/private address, never a public one.
MUNEEM_METRICS_BIND=127.0.0.1
# Business-health probes: the fast probes, the journal scans, and how many devices get their own series.
MUNEEM_HEALTH_PROBE_INTERVAL=60s
MUNEEM_HEALTH_LEDGER_INTERVAL=15m
MUNEEM_HEALTH_TOP_DEVICES=50
