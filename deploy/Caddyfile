{
	email {$ACME_EMAIL}
}

{$MUNEEM_API_DOMAIN} {
	# Mirrors the API's own 2 MiB body limit (a sync push); backups go straight to object storage by presigned URL.
	request_body {
		max_size 2MiB
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "interest-cohort=()"
		-Server
	}

	reverse_proxy api:8080 {
		# Hold requests while the API container restarts during a deploy, instead of failing them.
		lb_try_duration 30s
		lb_try_interval 500ms
	}

	log {
		output stdout
		format json
	}
}
