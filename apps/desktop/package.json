{
  "name": "@muneem/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Muneem desktop (Electron main + preload + React renderer)",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "gen": "tsx ../../scripts/gen-preload.ts",
    "native": "tsx scripts/build-native.ts",
    "dev": "pnpm gen && pnpm native && electron-vite dev",
    "build": "pnpm gen && electron-vite build",
    "start": "electron-vite preview",
    "package": "pnpm build && pnpm native && electron-builder --win nsis",
    "typecheck": "pnpm gen && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "pnpm gen && eslint src test scripts",
    "test": "pnpm gen && vitest run",
    "crash-loop": "tsx scripts/crash-loop.ts",
    "soak": "MUNEEM_SOAK_DAYS=365 vitest run test/soak",
    "sim": "MUNEEM_SIM_SEEDS=500 vitest run test/sync/simulation.test.ts"
  },
  "dependencies": {
    "@muneem/contracts": "workspace:*",
    "@muneem/db-sqlite": "workspace:*",
    "@muneem/domain": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "^12.2.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "pino": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@muneem/sync-reference": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
