{
  "name": "@muneem/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "IPC contract registry (zod), error taxonomy, sync protocol types, OpenAPI HTTP contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "openapi"],
  "scripts": {
    "gen": "openapi-typescript openapi/muneem-v1.yaml -o src/http/generated.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": { "zod": "^3.25.0" },
  "devDependencies": { "openapi-typescript": "^7.8.0" }
}
